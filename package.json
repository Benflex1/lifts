{
  "name": "lifts",
  "version": "1.0.5",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@kingstinct/react-native-healthkit": "^15.1.0",
    "expo": "~57.0.22",
    "expo-build-properties": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.1",
    "expo-notifications": "~57.0.18",
    "expo-sharing": "~57.0.19",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.41.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.2.3",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "start": "expo start",
    "tunnel": "node scripts/tunnel.cjs",
    "tunnel:ngrok": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:check": "node scripts/check-version-sync.mjs",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --experimental-test-module-mocks --import tsx --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=90 --test-coverage-branches=83 --test-coverage-functions=89 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "audit:policy": "node scripts/audit-policy.mjs",
    "check:dead-code": "node scripts/dead-code-scan.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "npm@11.19.1",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-notifications"
        ],
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}
